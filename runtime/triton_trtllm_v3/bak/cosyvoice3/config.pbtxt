name: "cosyvoice3"
backend: "python"
max_batch_size: 16
dynamic_batching {
    max_queue_delay_microseconds: 0
}
model_transaction_policy {
  decoupled: False
}
parameters [
  {
   key: "llm_tokenizer_dir",
   value: {string_value:"/gpfs01/nfs_share/data20250106/panxb/waihu_yixin/cosyvoice_trtllm/CosyVoice/runtime/triton_trtllm_v3/transformers_cosyvoice3_llm_zh_en_malay_spanish_arabic_singlish_data_v4"}
  },
  {
   key: "model_dir",
   value: {string_value:"/gpfs01/nfs_share/data20250106/panxb/waihu_yixin/cosyvoice_trtllm/CosyVoice/runtime/triton_trtllm_v3/Fun-CosyVoice3-0.5B_zh_en_malay_spanish_arabic_singlish_data_v4"}
  }
]

input [
  {
    name: "reference_wav"
    data_type: TYPE_FP32
    dims: [-1]
    optional: true
  },
  {
    name: "reference_wav_len"
    data_type: TYPE_INT32
    dims: [1]
    optional: true
  },
  {
    name: "reference_text"
    data_type: TYPE_STRING
    dims: [1]
    optional: true
  },
  {
    name: "target_text"
    data_type: TYPE_STRING
    dims: [1]
  }
]
output [
  {
    name: "waveform"
    data_type: TYPE_FP32
    dims: [ -1 ]
  }
]

instance_group [
  {
    count: 4
    kind: KIND_CPU
  }
]